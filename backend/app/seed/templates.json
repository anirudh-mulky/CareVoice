    "follow_up_day": 7,
    "medicines": [
      {
        "name": "Paracetamol 500 mg",
        "dose": "1 tablet",
        "frequency": "up to 3 times a day when in pain",
        "duration_days": 5
      },
      {
        "name": "Cefuroxime 500 mg",
        "dose": "1 tablet",
        "frequency": "2 times a day",
        "duration_days": 5
      },
      {
        "name": "Iron and folic acid",
        "dose": "1 tablet",
        "frequency": "once a day",
        "duration_days": 90
      },
      {
        "name": "Lactulose syrup",
        "dose": "15 ml",
        "frequency": "at night when needed",
        "duration_days": 7
      }
    ],
    "dos": [
      "Keep the wound clean and dry",
      "Walk a little several times a day",
      "Drink plenty of water and eat food with fibre",
      "Support your tummy with a pillow when you cough or feed the baby"
    ],
    "donts": [
      "Do not lift anything heavier than your baby for 6 weeks",
      "Do not sit in a tub or swim until the wound heals",
      "Do not drive for 4 weeks",
      "No sex for 6 weeks"
    ],
