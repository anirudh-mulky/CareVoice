# CareVoice runs with NO .env file. Copy to .env only to override defaults.

# demo = no keys needed; real = use the providers below
PROVIDER_MODE=demo

# Database (SQLite by default; Postgres URL in production)
DATABASE_URL=sqlite:////app/data/carevoice.db

# Audio storage
MEDIA_DIR=./data/media
S3_BUCKET=

# Real mode, step by step (keys only here or in your shell, never in git):
#   PROVIDER_MODE=real
#   STT_PROVIDER=sarvam  TTS_PROVIDER=sarvam  TRANSLATE_PROVIDER=sarvam  SARVAM_API_KEY=...
#   LLM_PROVIDER=anthropic  LLM_API_KEY=...
# Anything without its key stays in demo mode and the staff badge says "Key not set".

# Speech and translation: browser (demo) | sarvam (built) | bhashini (not built yet)
# TRANSLATE_PROVIDER=llm translates live texts with the LLM below (needs LLM_PROVIDER=anthropic)
STT_PROVIDER=browser
TTS_PROVIDER=browser
TRANSLATE_PROVIDER=browser
SARVAM_API_KEY=
BHASHINI_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TRANSLATE_MODEL=mayura:v1

# LLM: anthropic (built) | openai, gemini (not built yet). Empty LLM_MODEL = claude-opus-5-5
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Seconds before a provider call gives up (the app then falls back)
PROVIDER_TIMEOUT_SECONDS=20

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# Enables "Simulate next day" and demo reset; set false in production
DEMO_ENDPOINTS=true
# Seed synthetic demo data when the database is empty
SEED_ON_STARTUP=true

# Feature modules to load: "all" or a comma-separated list
ENABLED_MODULES=all
# Delivery channels: in_app now; whatsapp, sms, ivr later
ENABLED_CHANNELS=in_app

# Clinical tuning
TEACHBACK_PASS_THRESHOLD=0.75
TEACHBACK_MAX_TRIES=2
STT_CONFIDENCE_ALERT_THRESHOLD=0.6

# Reports: largest recording a patient can upload (bytes)
REPORT_AUDIO_MAX_BYTES=2000000

# Reminders: template times are hospital-local (India = 330 minutes ahead of UTC)
HOSPITAL_UTC_OFFSET_MINUTES=330
# How often due reminders are sent (seconds); 0 turns the background loop off
REMINDER_TICK_SECONDS=60

# Demo/QA only: make providers fail on purpose to show the fallbacks ("llm", "translate")
SIMULATE_FAILURES=
